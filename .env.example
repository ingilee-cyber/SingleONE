# 이 파일을 복사해 .env로 만들고 실제 값을 채워 사용한다. .env는 Git에 커밋되지 않는다.

# --- MySQL (docker-compose + Backend spring.datasource) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=singleone
MYSQL_USER=singleone
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme-root

# --- ClickHouse (docker-compose + Backend singleone.clickhouse.*) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=singleone
CLICKHOUSE_USER=singleone
CLICKHOUSE_PASSWORD=changeme

# --- Backend ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:3000

# --- Frontend (frontend/.env.example 참고) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
